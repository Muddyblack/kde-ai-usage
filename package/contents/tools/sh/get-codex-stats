#!/usr/bin/env bash
# Aggregate lifetime Codex usage from ~/.codex/sessions rollouts into a stats
# blob shaped like Claude's ~/.claude/stats-cache.json, so the QML side can
# render both with the same tiles.
#
# Rollouts are JSONL and can reach tens of MB each (~300MB total), so each file
# gets exactly one awk pass that emits a compact record, and a single jq pass
# aggregates them. Results are cached and only recomputed when a rollout is
# newer than the cache.
set -uo pipefail

SESSIONS="${CODEX_SESSIONS_DIR:-$HOME/.codex/sessions}"
CONFIG="${CODEX_CONFIG_FILE:-$HOME/.codex/config.toml}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/kde-ai-usage"
CACHE="$CACHE_DIR/codex-stats.json"

[ -d "$SESSIONS" ] || { echo '{}'; exit 0; }
command -v jq >/dev/null 2>&1 || { printf '%s\n' '{"error":"jq is required"}'; exit 0; }

# Serve the cache unless some rollout changed since it was written.
if [ -f "$CACHE" ] && [ -z "$(find "$SESSIONS" -name '*.jsonl' -newer "$CACHE" -print -quit 2>/dev/null)" ]; then
    cat "$CACHE"
    exit 0
fi

# Fallback model/effort for when no rollout records them.
cfg_model=$(grep -oE '^[[:space:]]*model[[:space:]]*=[[:space:]]*"[^"]*"' "$CONFIG" 2>/dev/null | head -1 | cut -d'"' -f2)
cfg_effort=$(grep -oE '^[[:space:]]*model_reasoning_effort[[:space:]]*=[[:space:]]*"[^"]*"' "$CONFIG" 2>/dev/null | head -1 | cut -d'"' -f2)

# Single pass per rollout: counts tool calls and user messages, tracks the last
# model/effort seen, and keeps the final token_count event (which carries the
# session's cumulative usage).
read -r -d '' SCAN <<'AWK' || true
# Individual rollout lines can exceed 18MB (a single huge tool result), so every
# hot-path operation works on a bounded prefix. Only the small token_count and
# turn_context records are inspected beyond that.
function field(line, key,   m, s) {
  s = "\"" key "\":\""
  m = index(line, s)
  if (m == 0) return ""
  line = substr(line, m + length(s), 200)
  return substr(line, 1, index(line, "\"") - 1)
}
function num(line, key,   m, s, i, c, out) {
  s = "\"" key "\":"
  m = index(line, s)
  if (m == 0) return 0
  line = substr(line, m + length(s), 24)
  out = ""
  for (i = 1; i <= length(line); i++) {
    c = substr(line, i, 1)
    if (c ~ /[0-9]/) out = out c; else break
  }
  return out == "" ? 0 : out
}
{
  # timestamp and both type tags live in the first ~130 chars of every line.
  pre = substr($0, 1, 200)
  if (NR == 1) start = field(pre, "timestamp")
  lastpre = pre
  if (index(pre, "\"token_count\"")) tk = substr($0, 1, 4000)
  else if (index(pre, "\"turn_context\"")) {
    ctxline = substr($0, 1, 65536)
    mdl = field(ctxline, "model")
    eff = field(ctxline, "effort")
  }
  else if (index(pre, "\"function_call\"") || index(pre, "\"custom_tool_call\"")) tools++
  else if (index(pre, "\"user_message\"")) msgs++
}
END {
  end = field(lastpre, "timestamp")
  if (tk != "") {
    i = index(tk, "total_token_usage")
    if (i > 0) {
      rest = substr(tk, i, 400)
      inp = num(rest, "input_tokens");  cin = num(rest, "cached_input_tokens")
      out = num(rest, "output_tokens"); rea = num(rest, "reasoning_output_tokens")
      tot = num(rest, "total_tokens")
    }
    ctx = num(tk, "model_context_window")
  }
  printf "{\"date\":\"%s\",\"model\":\"%s\",\"effort\":\"%s\",\"start\":\"%s\",\"end\":\"%s\",\"tools\":%d,\"msgs\":%d,\"ctx\":%d,\"usage\":{\"input_tokens\":%d,\"cached_input_tokens\":%d,\"output_tokens\":%d,\"reasoning_output_tokens\":%d,\"total_tokens\":%d}}\n",
    DATE, (mdl == "" ? "unknown" : mdl), eff, start, end, tools+0, msgs+0, ctx+0, inp+0, cin+0, out+0, rea+0, tot+0
}
AWK

mkdir -p "$CACHE_DIR"

if ! find "$SESSIONS" -name '*.jsonl' -print0 2>/dev/null \
    | { while IFS= read -r -d '' f; do
            d=$(printf '%s' "$f" | sed -nE 's#.*/([0-9]{4})/([0-9]{2})/([0-9]{2})/[^/]*$#\1-\2-\3#p')
            [ -n "$d" ] || continue
            awk -v DATE="$d" "$SCAN" "$f" 2>/dev/null
        done; } \
    | jq -s --arg cm "$cfg_model" --arg ce "$cfg_effort" '
    def secs: if . == "" then 0 else ((sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601?) // 0) end;

    (map(select(.date != "")) | sort_by(.start)) as $s |
    ($s | group_by(.model) | map({
        key: .[0].model,
        value: {
            inputTokens:     (map(.usage.input_tokens) | add // 0),
            cachedInput:     (map(.usage.cached_input_tokens) | add // 0),
            outputTokens:    (map(.usage.output_tokens) | add // 0),
            reasoningTokens: (map(.usage.reasoning_output_tokens) | add // 0),
            totalTokens:     (map(.usage.total_tokens) | add // 0),
            contextWindow:   ([.[] | .ctx | select(. > 0)] | last // 0),
            sessions:        length
        }
    }) | from_entries) as $modelUsage |
    ($s | group_by(.date) | map({
        date: .[0].date,
        sessionCount: length,
        messageCount: (map(.msgs) | add // 0),
        toolCallCount: (map(.tools) | add // 0),
        totalTokens: (map(.usage.total_tokens) | add // 0)
    })) as $daily |
    ($s | map({ms: (((.end | secs) - (.start | secs)) * 1000), messageCount: .msgs})
        | map(select(.ms > 0)) | sort_by(.ms) | last // {ms: 0, messageCount: 0}) as $longest |
    ($s | map(.start | select(. != "") | .[11:13]) | group_by(.)
        | map({key: .[0], value: length}) | from_entries) as $hours |
    {
        version: 1,
        source: "codex-sessions",
        lastComputedDate: (now | todateiso8601),
        totalSessions: ($s | length),
        totalMessages: ($s | map(.msgs) | add // 0),
        totalTokens: ($s | map(.usage.total_tokens) | add // 0),
        totalToolCalls: ($s | map(.tools) | add // 0),
        firstSessionDate: ($s | map(.date) | min // ""),
        model: ([$s[].model | select(. != "unknown" and . != "")] | last // $cm),
        effortLevel: ([$s[].effort | select(. != "")] | last // $ce),
        modelUsage: $modelUsage,
        dailyActivity: ($daily | map({date, sessionCount, messageCount, toolCallCount})),
        dailyModelTokens: ($daily | map({date, total: .totalTokens})),
        longestSession: {duration: $longest.ms, messageCount: $longest.messageCount},
        hourCounts: $hours
    }' > "$CACHE.tmp" 2>/dev/null; then
    rm -f "$CACHE.tmp"
    printf '%s\n' '{"error":"Codex stats scan failed"}'
    exit 0
fi

if [ -s "$CACHE.tmp" ]; then
    mv "$CACHE.tmp" "$CACHE"
    cat "$CACHE"
else
    rm -f "$CACHE.tmp"
    echo '{}'
fi
