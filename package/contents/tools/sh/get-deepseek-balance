#!/usr/bin/env bash
set -u

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/http.sh"
require_jq

API_KEY="$(resolve_key WIDGET_DEEPSEEK_API_KEY DEEPSEEK_API_KEY "$HOME/.config/deepseek/api-key")"
if [ -z "$API_KEY" ]; then
    echo "{}"
    exit 0
fi

http_json DEEPSEEK_BALANCE_RESPONSE_FILE "https://api.deepseek.com/user/balance" \
    -H "Authorization: Bearer $API_KEY" \
    -H "Accept: application/json" \
    -H "User-Agent: kde-ai-usage/deepseek"

if [ "$HTTP_STATUS" != "200" ]; then
    http_error_json "DeepSeek" "$HTTP_STATUS" "Invalid DeepSeek API key"
    exit 0
fi

if ! printf '%s' "$HTTP_BODY" | jq '
    if ((.balance_infos | type) == "array") then
        (.balance_infos // []) as $balances |
        (($balances | map(select(.currency == "USD"))[0]) // ($balances[0] // {})) as $primary |
        {
            hasKey: true,
            keyValid: true,
            isAvailable: (.is_available == true),
            balances: $balances,
            primaryCurrency: ($primary.currency // ""),
            primaryTotal: (($primary.total_balance // "0") | tonumber? // 0),
            primaryGranted: (($primary.granted_balance // "0") | tonumber? // 0),
            primaryToppedUp: (($primary.topped_up_balance // "0") | tonumber? // 0)
        }
    else
        { hasKey: true, keyValid: false, error: "DeepSeek unexpected response" }
    end' 2>/dev/null; then
    error_json "DeepSeek invalid JSON"
fi
