#!/usr/bin/env bash
# get-mistral-usage — Resolve Mistral API key and verify it, plus read vibe CLI session stats.
# Mistral has no public billing API, so we:
#   1. Resolve the key (widget config > env var > vibe .env > known config files)
#   2. Call GET /v1/models to verify validity and get the model list
#   3. Read ~/.vibe session logs for local cost / token / session stats

API_KEY="${WIDGET_MISTRAL_API_KEY:-}"
[ -z "$API_KEY" ] && [ -n "$MISTRAL_API_KEY" ]                        && API_KEY="$MISTRAL_API_KEY"
# vibe CLI stores its key in ~/.vibe/.env
[ -z "$API_KEY" ] && [ -f "$HOME/.vibe/.env" ] && \
    API_KEY=$(grep -oP "(?<=MISTRAL_API_KEY=')[^']+" "$HOME/.vibe/.env" 2>/dev/null | head -1)
[ -z "$API_KEY" ] && [ -f "$HOME/.vibe/.env" ] && \
    API_KEY=$(grep -oP '(?<=MISTRAL_API_KEY=")[^"]+' "$HOME/.vibe/.env" 2>/dev/null | head -1)
[ -z "$API_KEY" ] && [ -f "$HOME/.vibe/.env" ] && \
    API_KEY=$(grep -m1 '^MISTRAL_API_KEY=' "$HOME/.vibe/.env" 2>/dev/null | cut -d= -f2- | tr -d "'\" \n\r")
[ -z "$API_KEY" ] && [ -f "$HOME/.config/mistral/api-key" ]           && API_KEY=$(cat "$HOME/.config/mistral/api-key"  2>/dev/null | tr -d '\n\r ')
[ -z "$API_KEY" ] && [ -f "$HOME/.mistral/api-key" ]                  && API_KEY=$(cat "$HOME/.mistral/api-key"         2>/dev/null | tr -d '\n\r ')
[ -z "$API_KEY" ] && [ -f "$HOME/.config/mistral.key" ]               && API_KEY=$(cat "$HOME/.config/mistral.key"      2>/dev/null | tr -d '\n\r ')

# ── Vibe CLI session stats ────────────────────────────────────────────────────
VIBE_SESSION_DIR="$HOME/.vibe/logs/session"
VIBE_CONFIG="$HOME/.vibe/config.toml"

VIBE_STATS='{}'
if [ -d "$VIBE_SESSION_DIR" ] && command -v jq >/dev/null 2>&1; then
    VIBE_STATS=$(
        find "$VIBE_SESSION_DIR" -name "meta.json" -type f 2>/dev/null \
        | sort -u \
        | xargs jq -s '
            map(select(.stats != null))
            | (sort_by(.start_time) | reverse) as $byNewest
            | {
                vibeSessionCount: length,
                vibeTotalCost:    (map(.stats.session_cost // 0) | add // 0),
                vibeTotalTokens:  (map(.stats.session_total_llm_tokens // 0) | add // 0),
                vibePromptTokens: (map(.stats.session_prompt_tokens // 0) | add // 0),
                vibeCompletionTokens: (map(.stats.session_completion_tokens // 0) | add // 0),
                vibeTotalSteps:   (map(.stats.steps // 0) | add // 0),
                vibeToolOk:       (map(.stats.tool_calls_succeeded // 0) | add // 0),
                vibeToolFail:     (map(.stats.tool_calls_failed // 0) | add // 0),
                vibeRecent: [ $byNewest[0:12][] | {
                    title:   (.title // "untitled"),
                    project: ((.environment.working_directory // "") | split("/") | last // ""),
                    branch:  (.git_branch // ""),
                    cost:    (.stats.session_cost // 0),
                    tokens:  (.stats.session_total_llm_tokens // 0),
                    start:   (.start_time // "")
                } ]
              }
        ' 2>/dev/null || echo '{}'
    )
fi

# Active model from vibe config
VIBE_MODEL=""
if [ -f "$VIBE_CONFIG" ]; then
    VIBE_MODEL=$(grep -m1 '^active_model' "$VIBE_CONFIG" 2>/dev/null | sed 's/.*= *"\?\([^"]*\)"\?.*/\1/' | tr -d '"')
fi

if [ -z "$API_KEY" ]; then
    echo "$VIBE_STATS" | jq --arg m "$VIBE_MODEL" '. + {vibeActiveModel: $m}'
    exit 0
fi

RESPONSE=$(curl -s -w "\n%{http_code}" \
    -H "Authorization: Bearer $API_KEY" \
    -H "Content-Type: application/json" \
    --max-time 8 \
    "https://api.mistral.ai/v1/models" 2>/dev/null)

HTTP_CODE=$(echo "$RESPONSE" | tail -1)
BODY=$(echo "$RESPONSE" | head -n -1)

case "$HTTP_CODE" in
    200)
        echo "$BODY" | jq --arg key "$API_KEY" --arg m "$VIBE_MODEL" --argjson vibe "$VIBE_STATS" \
            '$vibe + {mistralApiKey: $key, keyValid: true, vibeActiveModel: $m,
                      availableModels: [.data[]?.id // empty]}'
        ;;
    401)
        echo "$VIBE_STATS" | jq --arg m "$VIBE_MODEL" \
            '. + {mistralApiKey: "", keyValid: false, vibeActiveModel: $m,
                  error: "Invalid API key (401)"}'
        ;;
    429)
        echo "$VIBE_STATS" | jq --arg key "$API_KEY" --arg m "$VIBE_MODEL" \
            '. + {mistralApiKey: $key, keyValid: true, vibeActiveModel: $m,
                  error: "Rate limited (429)"}'
        ;;
    *)
        echo "$VIBE_STATS" | jq --arg code "$HTTP_CODE" --arg m "$VIBE_MODEL" \
            '. + {mistralApiKey: "", keyValid: false, vibeActiveModel: $m,
                  error: ("HTTP " + $code)}'
        ;;
esac
