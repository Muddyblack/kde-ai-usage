#!/usr/bin/env bash
# get-mistral-usage — Resolve Mistral API key and verify it, plus read vibe CLI session stats.
# Mistral has no public billing API, so we:
#   1. Resolve the key (widget config > env var > vibe .env > known config files)
#   2. Call GET /v1/models to verify validity and get the model list
#   3. Read ~/.vibe session logs for local cost / token / session stats
set -u

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/http.sh"
require_jq

VIBE_ENV="$HOME/.vibe/.env"
API_KEY="$(resolve_key WIDGET_MISTRAL_API_KEY MISTRAL_API_KEY \
    "$HOME/.config/mistral/api-key" "$HOME/.mistral/api-key" "$HOME/.config/mistral.key")"

# vibe CLI stores its key inside an .env assignment rather than on its own line,
# so it needs parsing the shared file fallback cannot do.
if [ -z "$API_KEY" ] && [ -f "$VIBE_ENV" ]; then
    API_KEY=$(grep -m1 '^MISTRAL_API_KEY=' "$VIBE_ENV" 2>/dev/null | cut -d= -f2- | tr -d "'\" \n\r")
fi

# ── Vibe CLI session stats ────────────────────────────────────────────────────
VIBE_SESSION_DIR="$HOME/.vibe/logs/session"
VIBE_CONFIG="$HOME/.vibe/config.toml"

VIBE_STATS='{}'
if [ -d "$VIBE_SESSION_DIR" ]; then
    VIBE_STATS=$(
        find "$VIBE_SESSION_DIR" -name "meta.json" -type f 2>/dev/null |
            sort -u |
            xargs jq -s '
            map(select(.stats != null))
            | (sort_by(.start_time) | reverse) as $byNewest
            | {
                vibeSessionCount: length,
                vibeTotalCost:    (map(.stats.session_cost // 0) | add // 0),
                vibeTotalTokens:  (map(.stats.session_total_llm_tokens // 0) | add // 0),
                vibePromptTokens: (map(.stats.session_prompt_tokens // 0) | add // 0),
                vibeCompletionTokens: (map(.stats.session_completion_tokens // 0) | add // 0),
                vibeTotalSteps:   (map(.stats.steps // 0) | add // 0),
                vibeToolOk:       (map(.stats.tool_calls_succeeded // 0) | add // 0),
                vibeToolFail:     (map(.stats.tool_calls_failed // 0) | add // 0),
                vibeRecent: [ $byNewest[0:12][] | {
                    title:   (.title // "untitled"),
                    project: ((.environment.working_directory // "") | split("/") | last // ""),
                    branch:  (.git_branch // ""),
                    cost:    (.stats.session_cost // 0),
                    tokens:  (.stats.session_total_llm_tokens // 0),
                    start:   (.start_time // "")
                } ]
              }
        ' 2>/dev/null || echo '{}'
    )
fi

# Active model from vibe config
VIBE_MODEL=""
if [ -f "$VIBE_CONFIG" ]; then
    VIBE_MODEL=$(grep -m1 '^active_model' "$VIBE_CONFIG" 2>/dev/null | sed 's/.*= *"\?\([^"]*\)"\?.*/\1/' | tr -d '"')
fi

# Local vibe statistics are worth showing even when the key is missing or
# rejected, so every exit path below merges them in.
emit() {
    printf '%s' "$VIBE_STATS" | jq --arg m "$VIBE_MODEL" ". + {vibeActiveModel: \$m} + $1"
}

if [ -z "$API_KEY" ]; then
    emit '{hasKey: false, keyValid: false}'
    exit 0
fi

HTTP_TIMEOUT=8 http_json MISTRAL_RESPONSE_FILE "https://api.mistral.ai/v1/models" \
    -H "Authorization: Bearer $API_KEY" \
    -H "Content-Type: application/json"

case "$HTTP_STATUS" in
    200)
        printf '%s' "$HTTP_BODY" | jq --arg m "$VIBE_MODEL" --argjson vibe "$VIBE_STATS" \
            '$vibe + {hasKey: true, keyValid: true, vibeActiveModel: $m,
                      availableModels: [.data[]?.id // empty]}' ||
            emit '{hasKey: true, keyValid: false, error: "Mistral invalid JSON"}'
        ;;
    401 | 403)
        emit '{hasKey: true, keyValid: false, error: "Invalid API key (401)"}'
        ;;
    429)
        emit '{hasKey: true, keyValid: true, error: "Rate limited (429)"}'
        ;;
    000 | '')
        emit '{hasKey: true, keyValid: false, error: "Mistral network error"}'
        ;;
    *)
        emit "{hasKey: true, keyValid: false, error: \"HTTP $HTTP_STATUS\"}"
        ;;
esac
