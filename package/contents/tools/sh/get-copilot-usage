#!/usr/bin/env bash
set -u

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/http.sh"
require_jq

API_KEY="$(resolve_key WIDGET_GITHUB_TOKEN GITHUB_TOKEN "$HOME/.config/github-copilot/token")"
if [ -z "$API_KEY" ]; then
    echo "{}"
    exit 0
fi

QUOTA="${WIDGET_COPILOT_QUOTA:-${COPILOT_QUOTA:-}}"
case "$QUOTA" in
    '' | *[!0-9]*) QUOTA=300 ;;
esac

github_get() {
    http_json "$1" "$2" \
        -H "Authorization: Bearer $API_KEY" \
        -H "Accept: application/vnd.github+json" \
        -H "X-GitHub-Api-Version: 2022-11-28" \
        -H "User-Agent: kde-ai-usage/copilot"
}

github_get COPILOT_USER_RESPONSE_FILE "https://api.github.com/user"
USER_BODY="$HTTP_BODY"
if [ "$HTTP_STATUS" != "200" ]; then
    http_error_json "GitHub" "$HTTP_STATUS" "Invalid GitHub token"
    exit 0
fi

USERNAME="$(printf '%s' "$USER_BODY" | jq -r 'if ((.login | type) == "string" and (.login | length) > 0) then .login else empty end' 2>/dev/null)"
if [ -z "$USERNAME" ]; then
    error_json "GitHub username missing"
    exit 0
fi

github_get COPILOT_USAGE_RESPONSE_FILE \
    "https://api.github.com/users/$USERNAME/settings/billing/premium_request/usage"
USAGE_BODY="$HTTP_BODY"
if [ "$HTTP_STATUS" != "200" ]; then
    http_error_json "GitHub Copilot" "$HTTP_STATUS" \
        "GitHub token cannot read Copilot premium request usage"
    exit 0
fi

if ! printf '%s' "$USAGE_BODY" | jq --arg username "$USERNAME" --argjson quota "$QUOTA" '
    (if type == "array" then . else (.usageItems // []) end) as $items |
    ($items | map((.grossQuantity // 0) | if type == "number" then . else (tonumber? // 0) end) | add // 0) as $used |
    {
        hasKey: true,
        keyValid: true,
        username: $username,
        used: $used,
        quota: $quota,
        pct: (if $quota > 0 then ([100, (($used / $quota) * 100)] | min) else 0 end)
    }' 2>/dev/null; then
    error_json "GitHub Copilot invalid JSON"
fi
