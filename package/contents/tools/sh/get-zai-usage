#!/usr/bin/env bash
set -u

. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/http.sh"
require_jq

API_KEY="$(resolve_key WIDGET_ZAI_TOKEN ZAI_TOKEN "$HOME/.config/zai/token")"
if [ -z "$API_KEY" ]; then
    echo "{}"
    exit 0
fi

http_json ZAI_RESPONSE_FILE "https://api.z.ai/api/monitor/usage/quota/limit" \
    -H "Authorization: Bearer $API_KEY" \
    -H "Accept: application/json" \
    -H "User-Agent: kde-ai-usage/zai"

if [ "$HTTP_STATUS" != "200" ]; then
    http_error_json "Z.AI" "$HTTP_STATUS" "Invalid Z.AI token"
    exit 0
fi

# The credential never leaves this process: the backend only needs to know that
# one was found.
if ! printf '%s' "$HTTP_BODY" | jq '
    if (.success == false) then
        { hasKey: true, keyValid: false, error: (.msg // "Z.AI API error") }
    elif (
        .success == true
        and (.data | type) == "object"
        and (.data.limits | type) == "array"
        and ((.data.limits | map(select(.type == "TOKENS_LIMIT" or .type == "TIME_LIMIT")) | length) > 0)
    ) then
        (.data // {}) as $d |
        (($d.limits // []) | map(select(.type == "TOKENS_LIMIT"))[0] // {}) as $tok |
        (($d.limits // []) | map(select(.type == "TIME_LIMIT"))[0] // {}) as $tools |
        {
            hasKey: true,
            keyValid: true,
            level: ($d.level // ""),
            tokenPct: ($tok.percentage // 0),
            tokenResetMs: ($tok.nextResetTime // null),
            tokenUsed: ($tok.used // $tok.usage // null),
            tokenLimit: ($tok.limit // $tok.total // null),
            toolsPct: ($tools.percentage // 0),
            toolsRemaining: ($tools.remaining // null),
            toolsResetMs: ($tools.nextResetTime // null),
            models: ($tools.usageDetails // [])
        }
    else
        { hasKey: true, keyValid: false, error: "Z.AI unexpected response" }
    end' 2>/dev/null; then
    error_json "Z.AI invalid JSON"
fi
